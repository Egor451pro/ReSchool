generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Деньги в приложении хранятся целыми копейками.
// Отдел образования — учреждение типа DEPARTMENT, не школа.

enum InstitutionType {
  SCHOOL
  GYMNASIUM
  LYCEUM
  COLLEGE
  VOCATIONAL
  DEPARTMENT
}

enum UserRole {
  DONOR_STAFF
  WORKSHOP_MASTER
  STUDENT
  DISTRICT_ANALYST
  PLATFORM_ADMIN
}

enum ItemCondition {
  WORKING
  REPAIRABLE
  SCRAP
}

enum ItemStatus {
  LISTED
  REQUESTED
  IN_REPAIR
  READY
  DELIVERED
  CLOSED
}

enum CloseReason {
  COMPLETED
  WITHDRAWN
  UNREPAIRABLE
}

enum OrderStatus {
  ASSIGNED
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  OPEN
  MATCHED
  CLOSED
}

enum DocumentType {
  TRANSFER_ACT
  RETURN_ACT
  WRITE_OFF_DRAFT
}

enum ScenarioKind {
  CONSERVATIVE
  BASE
  OPTIMISTIC
}

model Institution {
  id        String          @id @default(cuid())
  name      String
  type      InstitutionType
  district  String
  address   String
  lat       Float
  lng       Float
  phone     String
  email     String
  users     User[]
  items     Item[]
  groups    StudyGroup[]
  orders    RepairOrder[]   @relation("WorkshopOrders")
  requests  Request[]
  sent      Transfer[]      @relation("TransferFrom")
  received  Transfer[]      @relation("TransferTo")
  createdAt DateTime        @default(now())
}

model User {
  id             String             @id @default(cuid())
  fullName       String
  role           UserRole
  email          String             @unique
  passwordHash   String
  institutionId  String?
  institution    Institution?       @relation(fields: [institutionId], references: [id])
  groupId        String?
  group          StudyGroup?        @relation("GroupStudents", fields: [groupId], references: [id])
  ledGroups      StudyGroup[]       @relation("GroupMaster")
  listedItems    Item[]             @relation("ListedBy")
  ordersLed      RepairOrder[]      @relation("OrderMaster")
  participations OrderParticipant[]
  portfolio      PortfolioEntry[]
  statusEvents   StatusEvent[]
}

model Category {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String              @unique
  specialties CategorySpecialty[]
  items       Item[]
  requests    Request[]
  disposal    DisposalRate[]
}

model Specialty {
  id         String              @id @default(cuid())
  slug       String              @unique
  name       String              @unique
  categories CategorySpecialty[]
  groups     StudyGroup[]
  orders     RepairOrder[]
}

model CategorySpecialty {
  categoryId  String
  specialtyId String
  category    Category  @relation(fields: [categoryId], references: [id])
  specialty   Specialty @relation(fields: [specialtyId], references: [id])

  @@id([categoryId, specialtyId])
}

model StudyGroup {
  id            String        @id @default(cuid())
  name          String
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  specialtyId   String
  specialty     Specialty     @relation(fields: [specialtyId], references: [id])
  masterId      String
  master        User          @relation("GroupMaster", fields: [masterId], references: [id])
  students      User[]        @relation("GroupStudents")
  orders        RepairOrder[]
}

model Item {
  id              String        @id @default(cuid())
  institutionId   String
  institution     Institution   @relation(fields: [institutionId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  title           String
  description     String
  condition       ItemCondition
  status          ItemStatus
  closeReason     CloseReason?
  quantity        Int
  year            Int?
  newUnitPriceKop Int
  listedById      String
  listedBy        User          @relation("ListedBy", fields: [listedById], references: [id])
  photos          ItemPhoto[]
  orders          RepairOrder[]
  events          StatusEvent[]
  transfer        Transfer?
  requests        Request[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([institutionId])
  @@index([categoryId])
}

model ItemPhoto {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id])
  path   String
  sort   Int
}

model RepairOrder {
  id                    String             @id @default(cuid())
  itemId                String
  item                  Item               @relation(fields: [itemId], references: [id])
  workshopInstitutionId String
  workshop              Institution        @relation("WorkshopOrders", fields: [workshopInstitutionId], references: [id])
  specialtyId           String
  specialty             Specialty          @relation(fields: [specialtyId], references: [id])
  masterId              String
  master                User               @relation("OrderMaster", fields: [masterId], references: [id])
  groupId               String
  group                 StudyGroup         @relation(fields: [groupId], references: [id])
  status                OrderStatus
  dueDate               DateTime?
  plannedMaterialsKop   Int
  actualMaterialsKop    Int                @default(0)
  transportKop          Int                @default(0)
  plannedMinutes        Int
  actualMinutes         Int                @default(0)
  events                StatusEvent[]
  participants          OrderParticipant[]
  portfolio             PortfolioEntry[]
  snapshot              EconomySnapshot?
  documents             Document[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([workshopInstitutionId, status])
  @@index([itemId])
}

model OrderParticipant {
  orderId   String
  studentId String
  order     RepairOrder @relation(fields: [orderId], references: [id])
  student   User        @relation(fields: [studentId], references: [id])

  @@id([orderId, studentId])
}

model StatusEvent {
  id         String       @id @default(cuid())
  itemId     String
  item       Item         @relation(fields: [itemId], references: [id])
  orderId    String?
  order      RepairOrder? @relation(fields: [orderId], references: [id])
  fromStatus String
  toStatus   String
  actorId    String
  actor      User         @relation(fields: [actorId], references: [id])
  comment    String       @default("")
  createdAt  DateTime     @default(now())

  @@index([itemId, createdAt])
}

model Request {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  title         String
  description   String
  quantity      Int
  status        RequestStatus
  matchedItemId String?
  matchedItem   Item?         @relation(fields: [matchedItemId], references: [id])
  createdAt     DateTime      @default(now())
}

model Transfer {
  id                String      @id @default(cuid())
  itemId            String      @unique
  item              Item        @relation(fields: [itemId], references: [id])
  fromInstitutionId String
  toInstitutionId   String
  from              Institution @relation("TransferFrom", fields: [fromInstitutionId], references: [id])
  to                Institution @relation("TransferTo", fields: [toInstitutionId], references: [id])
  transferredAt     DateTime
  documentId        String?
  document          Document?   @relation(fields: [documentId], references: [id])
}

model Document {
  id        String       @id @default(cuid())
  type      DocumentType
  number    String       @unique
  orderId   String?
  order     RepairOrder? @relation(fields: [orderId], references: [id])
  // JSON снимка реквизитов. PDF рисуется из него и не является источником правды.
  payload   String
  transfers Transfer[]
  createdAt DateTime     @default(now())
}

model AssumptionSet {
  id                       String         @id @default(cuid())
  kind                     ScenarioKind   @unique
  title                    String
  shownOnDashboard         Boolean        @default(false)
  expectedListedPerYear    Int
  avgNewPriceKop           Int
  avgMaterialsKop          Int
  avgDisposalKop           Int
  defaultTransportKop      Int
  practiceConsumableKop    Int
  substitutionMilli        Int
  completionMilli          Int
  hostingKopAnnual         Int
  supportKopAnnual         Int
  illustrativeLaborKopHour Int
  basisNote                String
  disposalRates            DisposalRate[]
  snapshots                EconomySnapshot[]
}

model DisposalRate {
  assumptionId String
  categoryId   String
  perUnitKop   Int
  assumption   AssumptionSet @relation(fields: [assumptionId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])

  @@id([assumptionId, categoryId])
}

model EconomySnapshot {
  id                   String         @id @default(cuid())
  orderId              String         @unique
  order                RepairOrder    @relation(fields: [orderId], references: [id])
  assumptionId         String
  assumption           AssumptionSet  @relation(fields: [assumptionId], references: [id])
  newPriceKop          Int
  materialsKop         Int
  transportKop         Int
  procurementSavingKop Int
  avoidedDisposalKop   Int
  propertyBudgetKop    Int
  practiceSavingKop    Int
  computedAt           DateTime       @default(now())
}

model PortfolioEntry {
  id            String      @id @default(cuid())
  studentId     String
  student       User        @relation(fields: [studentId], references: [id])
  orderId       String
  order         RepairOrder @relation(fields: [orderId], references: [id])
  skills        String
  grade         Int
  minutes       Int
  masterComment String      @default("")
  createdAt     DateTime    @default(now())

  @@index([studentId])
}
