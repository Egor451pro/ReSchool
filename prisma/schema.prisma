generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Деньги в приложении хранятся целыми копейками.
// Отдел образования — учреждение типа DEPARTMENT, не школа.
// Ремонт выполняют только фрилансеры.

enum InstitutionType {
  SCHOOL
  GYMNASIUM
  LYCEUM
  COLLEGE
  VOCATIONAL
  DEPARTMENT
}

enum UserRole {
  DONOR_STAFF
  FREELANCER
  DISTRICT_ANALYST
  PLATFORM_ADMIN
}

enum ItemCondition {
  WORKING
  REPAIRABLE
  SCRAP
}

enum ItemStatus {
  LISTED
  REQUESTED
  IN_REPAIR
  READY
  DELIVERED
  CLOSED
}

enum CloseReason {
  COMPLETED
  WITHDRAWN
  UNREPAIRABLE
}

enum OrderStatus {
  ASSIGNED
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  OPEN
  MATCHED
  CLOSED
}

enum DocumentType {
  TRANSFER_ACT
  RETURN_ACT
  WRITE_OFF_DRAFT
  PAYOUT_ACT
}

enum ScenarioKind {
  CONSERVATIVE
  BASE
  OPTIMISTIC
}

enum WalletTxnKind {
  PAYOUT
  BONUS
  ADJUSTMENT
}

model Institution {
  id        String          @id @default(cuid())
  name      String
  type      InstitutionType
  district  String
  address   String
  lat       Float?
  lng       Float?
  phone     String
  email     String
  users     User[]
  items     Item[]
  requests  Request[]
  sent      Transfer[]      @relation("TransferFrom")
  received  Transfer[]      @relation("TransferTo")
  createdAt DateTime        @default(now())
}

model User {
  id             String            @id @default(cuid())
  fullName       String
  role           UserRole
  email          String            @unique
  passwordHash   String
  institutionId  String?
  institution    Institution?      @relation(fields: [institutionId], references: [id])
  listedItems    Item[]            @relation("ListedBy")
  ordersLed      RepairOrder[]     @relation("OrderMaster")
  skills         FreelancerSkill[]
  wallet         Wallet?
  statusEvents   StatusEvent[]
  chatMessages   OrderMessage[]
}

model Category {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String              @unique
  specialties CategorySpecialty[]
  items       Item[]
  requests    Request[]
  disposal    DisposalRate[]
}

model Specialty {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String              @unique
  categories  CategorySpecialty[]
  freelancers FreelancerSkill[]
}

model CategorySpecialty {
  categoryId  String
  specialtyId String
  category    Category  @relation(fields: [categoryId], references: [id])
  specialty   Specialty @relation(fields: [specialtyId], references: [id])

  @@id([categoryId, specialtyId])
}

model FreelancerSkill {
  userId      String
  specialtyId String
  user        User      @relation(fields: [userId], references: [id])
  specialty   Specialty @relation(fields: [specialtyId], references: [id])

  @@id([userId, specialtyId])
}

model Item {
  id              String        @id @default(cuid())
  institutionId   String
  institution     Institution   @relation(fields: [institutionId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  title           String
  description     String
  condition       ItemCondition
  status          ItemStatus
  closeReason     CloseReason?
  quantity         Int
  year             Int?
  newUnitPriceKop  Int
  /** Сколько школа готова заплатить за весь ремонт (обсуждается в чате). */
  repairBudgetKop  Int
  listedById       String
  listedBy        User          @relation("ListedBy", fields: [listedById], references: [id])
  photos          ItemPhoto[]
  orders          RepairOrder[]
  events          StatusEvent[]
  transfer        Transfer?
  requests        Request[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([institutionId])
  @@index([categoryId])
}

model ItemPhoto {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id])
  path   String
  sort   Int
}

model RepairOrder {
  id                  String             @id @default(cuid())
  itemId              String
  item                Item               @relation(fields: [itemId], references: [id])
  masterId            String
  master              User               @relation("OrderMaster", fields: [masterId], references: [id])
  status              OrderStatus
  dueDate             DateTime?
  plannedMaterialsKop Int
  actualMaterialsKop  Int                @default(0)
  transportKop        Int                @default(0)
  plannedMinutes      Int
  actualMinutes       Int                @default(0)
  agreedFeeKop        Int                @default(0)
  /** Когда завхоз принял предложение фрилансера. До этого ремонт не стартует. */
  schoolAcceptedAt    DateTime?
  events              StatusEvent[]
  messages            OrderMessage[]
  snapshot            EconomySnapshot?
  documents           Document[]
  walletTxns          WalletTransaction[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([masterId, status])
  @@index([itemId])
}

model OrderMessage {
  id        String      @id @default(cuid())
  orderId   String
  order     RepairOrder @relation(fields: [orderId], references: [id])
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model StatusEvent {
  id         String       @id @default(cuid())
  itemId     String
  item       Item         @relation(fields: [itemId], references: [id])
  orderId    String?
  order      RepairOrder? @relation(fields: [orderId], references: [id])
  fromStatus String
  toStatus   String
  actorId    String
  actor      User         @relation(fields: [actorId], references: [id])
  comment    String       @default("")
  createdAt  DateTime     @default(now())

  @@index([itemId, createdAt])
}

model Request {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  title         String
  description   String
  quantity      Int
  status        RequestStatus
  matchedItemId String?
  matchedItem   Item?         @relation(fields: [matchedItemId], references: [id])
  createdAt     DateTime      @default(now())
}

model Transfer {
  id                String      @id @default(cuid())
  itemId            String      @unique
  item              Item        @relation(fields: [itemId], references: [id])
  fromInstitutionId String
  toInstitutionId   String
  from              Institution @relation("TransferFrom", fields: [fromInstitutionId], references: [id])
  to                Institution @relation("TransferTo", fields: [toInstitutionId], references: [id])
  transferredAt     DateTime
  documentId        String?
  document          Document?   @relation(fields: [documentId], references: [id])
}

model Document {
  id        String       @id @default(cuid())
  type      DocumentType
  number    String       @unique
  orderId   String?
  order     RepairOrder? @relation(fields: [orderId], references: [id])
  // JSON снимка реквизитов. PDF рисуется из него и не является источником правды.
  payload   String
  transfers Transfer[]
  createdAt DateTime     @default(now())
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id])
  balanceKop   Int                 @default(0)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id        String        @id @default(cuid())
  walletId  String
  wallet    Wallet        @relation(fields: [walletId], references: [id])
  kind      WalletTxnKind
  amountKop Int
  orderId   String?
  order     RepairOrder?  @relation(fields: [orderId], references: [id])
  note      String        @default("")
  createdAt DateTime      @default(now())

  @@index([walletId, createdAt])
}

model AssumptionSet {
  id                       String            @id @default(cuid())
  kind                     ScenarioKind      @unique
  title                    String
  shownOnDashboard         Boolean           @default(false)
  expectedListedPerYear    Int
  avgNewPriceKop           Int
  avgMaterialsKop          Int
  avgDisposalKop           Int
  defaultTransportKop      Int
  practiceConsumableKop    Int
  substitutionMilli        Int
  completionMilli          Int
  hostingKopAnnual         Int
  supportKopAnnual         Int
  illustrativeLaborKopHour Int
  slesarAnnualSalaryKop    Int               @default(0)
  zavhozBonusShareMilli    Int               @default(0)
  freelancerAvgFeeKop      Int               @default(0)
  basisNote                String
  disposalRates            DisposalRate[]
  snapshots                EconomySnapshot[]
}

model DisposalRate {
  assumptionId String
  categoryId   String
  perUnitKop   Int
  assumption   AssumptionSet @relation(fields: [assumptionId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])

  @@id([assumptionId, categoryId])
}

model EconomySnapshot {
  id                   String        @id @default(cuid())
  orderId              String        @unique
  order                RepairOrder   @relation(fields: [orderId], references: [id])
  assumptionId         String
  assumption           AssumptionSet @relation(fields: [assumptionId], references: [id])
  newPriceKop          Int
  materialsKop         Int
  transportKop         Int
  freelancerFeeKop     Int           @default(0)
  procurementSavingKop Int
  avoidedDisposalKop   Int
  propertyBudgetKop    Int
  practiceSavingKop    Int           @default(0)
  computedAt           DateTime      @default(now())
}
